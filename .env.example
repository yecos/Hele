# HELE environment template
# Copy to .env.local for local development.
# Never commit real credentials.

DATABASE_URL=file:./db/dev.db
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TMDB_API_KEY=

# Comma-separated emails allowed to access admin features.
ADMIN_EMAILS=

# Legacy credential users. Prefer OAuth for normal usage.
ADMIN_PASSWORD=
HELE_PASSWORD=
USUARIO_PASSWORD=

# Required only when Xuper integration is enabled.
XUPER_DES_KEY=
